# Copy to .env.local for personal overrides.

# development | demo | production. Picked automatically (dev server = development, build = production).
APP_ENV=

# Base URL of the HandiMart API, including /api/v1. Read on the server only; the browser never
# talks to the backend directly. Dev backend for manual QA: http://16.16.63.171:8081/api/v1
HANDIMART_API_URL=http://localhost:8080/api/v1

# Optional shared secret the backend accepts in X-Handimart-Client-Key (backend: APP_TRUSTED_CLIENT_KEY).
# Server only, never NEXT_PUBLIC_.
HANDIMART_API_CLIENT_KEY=

# Public origin of this website (same-origin checks, cookie security).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Extra absolute image hosts (comma-separated): the S3 host that serves presigned private files,
# or a CDN. Example: handimart-media.s3.eu-central-1.amazonaws.com
HANDIMART_IMAGE_HOSTS=
